rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // Validation Blueprint for Task Entity
    function isValidTask(data) {
      return data.keys().hasAll([
          'userId',
          'title',
          'priority',
          'dueDate',
          'category',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'title',
          'priority',
          'dueDate',
          'category',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 180
        && data.priority is string
        && data.priority in ['Low', 'Medium', 'High']
        && data.dueDate is string
        && data.dueDate.size() <= 10
        && (data.dueDate == '' || data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && data.category is string
        && data.category in ['Work', 'Personal', 'Urgent', 'Errands', 'General']
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isTaskOwner() {
      return existing().userId == request.auth.uid;
    }

    function isToggleAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']);
    }

    function isEditAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'title',
        'priority',
        'dueDate',
        'category',
        'updatedAt'
      ]);
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn()
        && isVerified()
        && isValidId(taskId)
        && isTaskOwner();

      allow list: if isSignedIn()
        && isVerified()
        && isTaskOwner();

      allow create: if isSignedIn()
        && isVerified()
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isVerified()
        && isValidId(taskId)
        && isValidTask(incoming())
        && isTaskOwner()
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isToggleAction() || isEditAction());

      allow delete: if isSignedIn()
        && isVerified()
        && isValidId(taskId)
        && isTaskOwner();
    }
  }
}
